# Copy to .env. Only PUBLIC values go here: everything in a Vite .env is visible to visitors.
# Local: http://localhost:4000.  Free hosting with the Netlify proxy: same-origin
VITE_API_URL=http://localhost:4000
# WhatsApp number, with or without country code (08100090843 or 2348100090843)
VITE_WHATSAPP_NUMBER=08100090843
# While developing, show clearly labelled demo products if the API is not running.
# Set to false in production so visitors never see demo data by mistake.
VITE_USE_DEMO_FALLBACK=true
