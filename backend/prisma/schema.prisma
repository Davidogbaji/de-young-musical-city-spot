generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}
enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}
enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}
enum PaymentMethod {
  ONLINE
  BANK_TRANSFER
  PAY_ON_DELIVERY
  WHATSAPP_CONFIRM
}
enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTED
  CLOSED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role     @default(CUSTOMER)
  resetTokenHash    String?
  resetTokenExpires DateTime?
  tokenVersion      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  addresses    Address[]
  orders       Order[]
  wishlist     WishlistItem[]
  reviews      Review[]
}

model Address {
  id        Int     @id @default(autoincrement())
  userId    Int
  label     String?
  line1     String
  city      String
  state     String
  phone     String?
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  position    Int       @default(0)
  products    Product[]
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  logoUrl  String?
  products Product[]
}

model Product {
  id            Int           @id @default(autoincrement())
  name          String
  slug          String        @unique
  description   String        @default("")
  model         String?
  price         Int
  discountPrice Int?
  stock         Int           @default(0)
  specs         Json?
  warranty      String?
  status        ProductStatus @default(ACTIVE)
  isFeatured    Boolean       @default(false)
  isDemo        Boolean       @default(false)
  categoryId    Int
  brandId       Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  category      Category      @relation(fields: [categoryId], references: [id])
  brand         Brand?        @relation(fields: [brandId], references: [id])
  images        ProductImage[]
  orderItems    OrderItem[]
  wishlist      WishlistItem[]
  reviews       Review[]
  @@index([categoryId])
  @@index([brandId])
  @@index([status, createdAt])
  @@index([price])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  alt       String  @default("")
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
}

model Order {
  id          Int         @id @default(autoincrement())
  reference   String      @unique
  userId      Int?
  fullName    String
  email       String
  phone       String
  addressLine String
  city        String
  state       String
  notes       String?
  deliveryMethod String   @default("standard")
  paymentMethod  PaymentMethod @default(ONLINE)
  subtotal    Int
  deliveryFee Int         @default(0)
  total       Int
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User?       @relation(fields: [userId], references: [id])
  items       OrderItem[]
  payments    Payment[]
  @@index([userId])
  @@index([status, createdAt])
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int
  productId Int?
  name      String
  unitPrice Int
  quantity  Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([orderId])
}

model Payment {
  id              Int           @id @default(autoincrement())
  orderId         Int
  provider        String
  reference       String        @unique
  providerEventId String?       @unique
  amount          Int
  status          PaymentStatus @default(PENDING)
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  order           Order         @relation(fields: [orderId], references: [id])
  @@index([orderId])
}

model WishlistItem {
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([userId, productId])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  rating    Int
  comment   String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
}

model StudioEnquiry {
  id            Int           @id @default(autoincrement())
  fullName      String
  phone         String
  email         String?
  studioType    String
  budgetRange   String?
  location      String?
  requirements  String
  contactMethod String        @default("whatsapp")
  status        EnquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())
  @@index([status, createdAt])
}

model NewsletterSubscription {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  consent          Boolean
  unsubscribeToken String    @unique @default(cuid())
  subscribedAt     DateTime  @default(now())
  unsubscribedAt   DateTime?
}

model SiteSetting {
  key   String @id
  value String
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  quote     String
  isSample  Boolean  @default(true)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Banner {
  id        Int     @id @default(autoincrement())
  title     String
  imageUrl  String?
  linkUrl   String?
  position  Int     @default(0)
  active    Boolean @default(true)
}

model DeliveryZone {
  id     Int    @id @default(autoincrement())
  state  String @unique
  fee    Int
}
