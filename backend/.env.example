# Copy this file to .env and fill in real values. NEVER commit .env.
NODE_ENV=development
PORT=4000

# Local Postgres example, or paste the connection string from Neon/Supabase
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deyoung?schema=public"

# Comma-separated list of allowed website origins (CORS)
FRONTEND_URL=http://localhost:5173

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Payment options offered at checkout (comma-separated). Choices: WHATSAPP_CONFIRM, BANK_TRANSFER, PAY_ON_DELIVERY
# Online card payment is added in Stage 5.
PAYMENT_METHODS=WHATSAPP_CONFIRM

# Email for password-reset links. Leave blank in development: the reset link is printed in the terminal instead.
# In production use your email provider's SMTP details (for example your business mailbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="De Young Musical and City Spot <info@yourdomain.com>"

# Product photo storage. "local" saves files in the uploads folder (fine for your computer or a server with a persistent disk).
# On hosts that wipe files on restart (such as Render's free plan) use "cloudinary" and fill in the three values below.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# The public address of this API. Local uploads are served from here.
PUBLIC_API_URL=http://localhost:4000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Number of proxies in front of this server, so rate limits count each visitor separately.
# 1 = host's load balancer only (website and API on their own addresses).
# 2 = the free-hosting setup where Netlify forwards /api to Render (see docs/FREE_HOSTING.md).
TRUST_PROXY=1

# Public address of the website (used in the sitemap and email links). Defaults to the first FRONTEND_URL.
SITE_URL=

# Optional: used by the seed script to create the first admin account
SEED_ADMIN_EMAIL=ogidithomasiji43@gmail.com
SEED_ADMIN_PASSWORD=
